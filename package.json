{
  "name": "@mumulinya167/cc-web",
  "version": "2.0.14",
  "description": "本地优先的多 Agent 协作与自动开发工作区，集成任务编排、记忆上下文、MCP/Skill、TestAgent、Git、飞书、知识库和终端",
  "main": "dist/server.js",
  "bin": {
    "cc-web": "bin/ccm.js",
    "ccm": "bin/ccm.js"
  },
  "files": [
    "bin/",
    "dist/*.js",
    "dist/**/*.js",
    "public/index.html",
    "public/*.png",
    "public/*.svg",
    "public/assets/",
    "public/pets/yuexinmiao.svg",
    "public/pets/yuexinmiao-attention.svg",
    "public/pets/yuexinmiao-carrying.svg",
    "public/pets/yuexinmiao-collapsing.svg",
    "public/pets/yuexinmiao-dozing.svg",
    "public/pets/yuexinmiao-error.svg",
    "public/pets/yuexinmiao-happy.svg",
    "public/pets/yuexinmiao-idle-action1.svg",
    "public/pets/yuexinmiao-idle.svg",
    "public/pets/yuexinmiao-juggling.svg",
    "public/pets/yuexinmiao-notification.svg",
    "public/pets/yuexinmiao-react-double.svg",
    "public/pets/yuexinmiao-react-drag.svg",
    "public/pets/yuexinmiao-react-left.svg",
    "public/pets/yuexinmiao-react-right.svg",
    "public/pets/yuexinmiao-sleeping.svg",
    "public/pets/yuexinmiao-sweeping.svg",
    "public/pets/yuexinmiao-thinking.svg",
    "public/pets/yuexinmiao-waking.svg",
    "public/pets/yuexinmiao-working.svg",
    "public/pets/yuexinmiao-yawning.svg",
    "public/pets/clawd.svg",
    "public/pets/cloudling.svg",
    "public/pets/calico.svg",
    "public/pets/ghost.svg",
    "public/pets/robot.svg",
    "pet/main.js",
    "pet/preload.js",
    "pet/package.json",
    "pet/renderer/",
    "mcp-*/package.json",
    "mcp-*/internal-mcp.json",
    "mcp-*/dist/**/*",
    "templates/skills/*/SKILL.md",
    "templates/skills/*/references/",
    "README.md"
  ],
  "scripts": {
    "start": "node dist/server.js",
    "agent-runner": "node dist/agent-runner.js --watch",
    "agent-runner:ps": "powershell -ExecutionPolicy Bypass -File bin/agent-runner.ps1 -Watch",
    "postinstall": "node bin/postinstall.js",
    "prepack": "node bin/prepublish-guard.js --pack",
    "prepublishOnly": "node bin/prepublish-guard.js --publish"
  },
  "keywords": [
    "ai-agent",
    "multi-agent",
    "agent-orchestration",
    "agent-workspace",
    "automatic-development",
    "claude-code",
    "codex-cli",
    "cursor-agent",
    "antigravity-cli",
    "mcp",
    "model-context-protocol",
    "skills",
    "test-agent",
    "context-engine",
    "agent-memory",
    "rag",
    "local-embedding",
    "feishu",
    "git-workflow",
    "terminal",
    "cc-connect",
    "web-console"
  ],
  "author": "mumulinya167",
  "homepage": "https://github.com/mumulinya/ccm-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mumulinya/ccm-web.git"
  },
  "bugs": {
    "url": "https://github.com/mumulinya/ccm-web/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server-filesystem": "2026.7.10",
    "@napi-rs/canvas": "0.1.80",
    "@vscode/ripgrep": "1.18.0",
    "better-sqlite3": "11.10.0",
    "busboy": "1.6.0",
    "cc-connect": "^1.4.1",
    "js-tiktoken": "1.0.21",
    "minimatch": "10.0.1",
    "music-metadata": "11.14.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "5.4.624",
    "playwright": "^1.61.1",
    "sharp": "0.34.5",
    "typescript": "6.0.3",
    "undici": "^6.21.3",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "node-pty": "1.2.0-beta.14"
  }
}
